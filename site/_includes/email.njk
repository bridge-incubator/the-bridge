{#- Email button. assets/email.js fills in the address in the browser, so it never
    appears in the HTML that scrapers read. Optional: set `subject` before including. -#}
<div class="email">
	<a class="button" data-email="team|bridgecivictech.org" data-subject="{{ subject }}">Contact The Bridge</a>
	<p class="email-address">team [at] bridgecivictech.org</p>
</div>
